; Engine configuration file.
; 使用 Godot 编辑器修改后，请保留必要的项目设置。

config_version=5

[application]

config/name="Astro Adventure / 回声航路"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameEvents="*res://scripts/core/event_bus.gd"
ContentRegistry="*res://scripts/core/content_registry.gd"
I18n="*res://scripts/core/localization_service.gd"
Relics="*res://scripts/systems/relic_system.gd"
Achievements="*res://scripts/systems/achievement_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.031, 0.047, 0.078, 1)
